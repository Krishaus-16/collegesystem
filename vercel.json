{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/complaints/index.js", "use": "@vercel/node" },
    { "src": "api/complaints/[id].js", "use": "@vercel/node" },
    { "src": "api/health.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health.js" },
    { "source": "/api/complaints", "destination": "/api/complaints/index.js" },
    { "source": "/api/complaints/:id", "destination": "/api/complaints/[id].js?id=:id" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
